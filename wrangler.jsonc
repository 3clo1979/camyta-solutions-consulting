{
  "name": "camyta-solutions-consulting",
  "compatibility_date": "2026-10-23",
  "main": "worker.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ratelimits": [
    { "name": "CONTACT_RATE_LIMIT", "namespace_id": "197910231", "simple": { "limit": 3, "period": 60 } },
    { "name": "CONTACT_GLOBAL_LIMIT", "namespace_id": "197910232", "simple": { "limit": 10, "period": 60 } }
  ]
}
